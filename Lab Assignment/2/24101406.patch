@@ -0,0 +1,25 @@
+#include "kernel/types.h"
+#include "user/user.h"
+
+int
+main(int argc, char *argv[])
+{
+    int tickets;
+
+    if (argc != 2) {
+        printf("Usage: test_scheduler <tickets>\n");
+        exit(1);
+    }
+
+    tickets = atoi(argv[1]);
+
+    if (settickets(tickets) < 0) {
+        printf("Invalid ticket count\n");
+        exit(1);
+    }
+
+    while (1) {
+    }
+
+    exit(0);
+}
