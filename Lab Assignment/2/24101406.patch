diff --git a/kernel/proc.c b/kernel/proc.c
index 6275411..e652379 100644
--- a/kernel/proc.c
+++ b/kernel/proc.c
@@ -15,6 +15,35 @@ struct proc *initproc;
 int nextpid = 1;
 struct spinlock pid_lock;
 
+int
+do_rand(unsigned long *ctx)
+{
+  long hi, lo, x;
+
+  x = (*ctx % 0x7ffffffe) + 1;
+  hi = x / 127773;
+  lo = x % 127773;
+
+  x = 16807 * lo - 2836 * hi;
+
+  if (x < 0)
+    x += 0x7fffffff;
+
+  x--;
+
+  *ctx = x;
+
+  return (x);
+}
+
+unsigned long rand_next = 1;
+
+int
+rand(void)
+{
+  return (do_rand(&rand_next));
+}
+
 extern void forkret(void);
 static void freeproc(struct proc *p);
 
@@ -124,6 +153,7 @@ allocproc(void)
 found:
   p->pid = allocpid();
   p->state = USED;
+  p->rounds = 0;
 
   // Allocate a trapframe page.
   if ((p->trapframe = (struct trapframe *)kalloc()) == 0) {
@@ -223,6 +253,8 @@ userinit(void)
   p = allocproc();
   initproc = p;
 
+  p->tickets = 10;
+
   p->cwd = namei("/");
 
   p->state = RUNNABLE;
@@ -266,6 +298,7 @@ kfork(void)
   if ((np = allocproc()) == 0) {
     return -1;
   }
+  np->tickets = p->tickets;
 
   // Copy user memory from parent to child.
   if (uvmcopy(p->pagetable, np->pagetable, p->sz) < 0) {
@@ -441,30 +474,47 @@ scheduler(void)
     intr_on();
     intr_off();
 
-    int found = 0;
+    int total_tickets = 0;
+
     for (p = proc; p < &proc[NPROC]; p++) {
       acquire(&p->lock);
-      if (p->state == RUNNABLE) {
-        // Switch to chosen process.  It is the process's job
-        // to release its lock and then reacquire it
-        // before jumping back to us.
-        p->state = RUNNING;
-        c->proc = p;
-        swtch(&c->context, &p->context);
-
-        // Don't re-enable interrupts on release.
-        mycpu()->intena = 0;
-
-        // Process is done running for now.
-        // It should have changed its p->state before coming back.
-        c->proc = 0;
-        found = 1;
-      }
+
+      if (p->state == RUNNABLE)
+        total_tickets += p->tickets;
+
       release(&p->lock);
     }
-    if (found == 0) {
-      // nothing to run; stop running on this core until an interrupt.
+
+    if (total_tickets == 0) {
       asm volatile("wfi");
+      continue;
+    }
+
+    int lucky_ticket = rand() % total_tickets;
+    int tally = 0;
+
+    for (p = proc; p < &proc[NPROC]; p++) {
+      acquire(&p->lock);
+
+      if (p->state == RUNNABLE) {
+        tally += p->tickets;
+
+        if (lucky_ticket < tally) {
+          p->state = RUNNING;
+          c->proc = p;
+          p->rounds++;
+
+          swtch(&c->context, &p->context);
+
+          mycpu()->intena = 0;
+          c->proc = 0;
+
+          release(&p->lock);
+          break;
+        }
+      }
+
+      release(&p->lock);
     }
   }
 }
@@ -695,7 +745,7 @@ procdump(void)
       state = states[p->state];
     else
       state = "???";
-    printk("%d %s %s", p->pid, state, p->name);
+    printk("%d %s %s tickets=%d rounds=%d",p->pid, state, p->name, p->tickets, p->rounds);
     printk("\n");
   }
 }
